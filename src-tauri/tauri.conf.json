{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "나란히",
  "version": "0.1.0",
  "identifier": "com.local.parallel-translator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "나란히 — 로컬 병렬 번역 에디터",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "영어를 한국어로 실시간 번역하는 로컬 에디터"
  }
}
